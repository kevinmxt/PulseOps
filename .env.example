# Local development overrides for compose.yaml.
# Copy to .env and never commit .env. Values below are placeholders.
POSTGRES_DB=pulseops
POSTGRES_USER=pulseops
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

# If you change the values above, export matching DB_* variables before
# starting the backend, because the backend does not read .env directly:
# DB_URL=jdbc:postgresql://localhost:5432/pulseops
# DB_USERNAME=pulseops
# DB_PASSWORD=change-me-local
