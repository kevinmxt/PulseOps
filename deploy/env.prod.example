# 生产环境变量模板。复制到 /etc/pulseops/pulseops.env 并设置权限 600。
# 所有值均为占位符，部署前必须替换。

POSTGRES_DB=pulseops
POSTGRES_USER=pulseops
# 使用单引号避免 Compose 解释密码或哈希中的 `$`。
POSTGRES_PASSWORD='replace-with-strong-password'

# 首次启动且 app_user 为空时使用；必须替换为真实的 bcrypt 哈希。
PULSEOPS_AUTH_BOOTSTRAP_USERNAME=admin
PULSEOPS_AUTH_BOOTSTRAP_PASSWORD_HASH='{bcrypt}$2y$12$replace_with_generated_hash'
PULSEOPS_AUTH_RATE_LIMIT_MAX_KEYS=10000

# 留空表示不启用 Telegram 通知。
PULSEOPS_TELEGRAM_BOT_TOKEN=
PULSEOPS_TELEGRAM_CHAT_ID=

# 5A 使用本地域名与 Caddy 内部 CA；5B 改为真实域名与 ACME 邮箱。
SITE_ADDRESS=pulseops.test
TLS_ISSUER=internal

# 生产部署使用 Git short SHA；本地验证可用 local。
IMAGE_TAG=local

# 生产脚本与 systemd 单元使用固定的 Compose 文件与项目名。
COMPOSE_FILE=/opt/pulseops/compose.prod.yaml
COMPOSE_PROJECT_NAME=pulseops

# 自动备份。age 私钥放 /etc/pulseops/age.key（600），这里只放公钥。
BACKUP_DIR=/var/backups/pulseops
BACKUP_RETENTION_COUNT=7
BACKUP_OFFSITE_RETENTION_COUNT=14
AGE_RECIPIENT=age1replace-with-public-key
BACKUP_RCLONE_REMOTE=local
BACKUP_RCLONE_PATH=replace-with-remote-path
RCLONE_CONFIG=/etc/pulseops/rclone.conf
# 留空则跳过 Healthchecks；5B 填入真实成功 URL，失败由 OnFailure 追加 /fail。
HEALTHCHECKS_PING_URL=
